{
  "description": "Full-frame background (darkened, blurred cover art or brand image), scrolling white waveform through the middle, logo top-left, title + artist bottom-left. Falls back to a brand-colour gradient when there is no background.",
  "output": {
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "lyrics": {
    "position": "bottom",
    "margin_v": "H*0.20",
    "size": "H*0.06"
  },
  "layers": [
    {
      "if": "background_image",
      "component": "image",
      "cover": true,
      "blur": "{{brand.background_blur|12}}",
      "darken": "{{brand.background_darken|0.45}}",
      "set": {
        "image": "{{background_image}}"
      }
    },
    {
      "if": "background_video",
      "component": "video",
      "set": {
        "video": "{{background_video}}",
        "loop": true
      }
    },
    {
      "if": "!background",
      "component": "color",
      "set": {
        "color1": "{{brand.colors.background|#14142b}}",
        "color2": "{{brand.colors.secondary|#3a2160}}",
        "fillType": "Linear Gradient"
      }
    },
    {
      "component": "waveform",
      "set": {
        "mode": "Cline",
        "mono": true,
        "amplitude": "Linear",
        "color": "{{brand.colors.waveform|#ffffff}}",
        "opacity": 60
      }
    },
    {
      "if": "brand.logo",
      "component": "image",
      "fit": [
        "W*0.14",
        "H*0.12"
      ],
      "anchor": "top-left",
      "margin": "H*0.05",
      "set": {
        "image": "{{brand.logo}}"
      }
    },
    {
      "component": "text",
      "set": {
        "title": "{{title}}",
        "font": "{{brand.font.file|DejaVu Sans}}",
        "fontStyle": "Bold",
        "fontSize": "H*0.06",
        "textColor": "{{brand.colors.text|#ffffff}}",
        "alignment": "Left",
        "xPosition": "H*0.05",
        "yPosition": "H*0.86",
        "shadow": true
      }
    },
    {
      "if": "artist",
      "component": "text",
      "set": {
        "title": "{{artist}}",
        "font": "{{brand.font.file|DejaVu Sans}}",
        "fontSize": "H*0.035",
        "textColor": "{{brand.colors.primary|#ffcc00}}",
        "alignment": "Left",
        "xPosition": "H*0.05",
        "yPosition": "H*0.93",
        "shadow": true
      }
    }
  ]
}
